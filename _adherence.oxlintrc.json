      {
        "selector": "JSXOpeningElement[name.name='CountdownTimer'] > JSXAttribute > JSXIdentifier[name!=/^(?:to|label|theme|style|key|ref|className|style|children)$/]",
        "message": "<CountdownTimer> doesn't accept that prop. Declared props: to, label, theme, style."
